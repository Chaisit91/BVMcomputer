// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

// Every sellable catalog item — the 8 individual part categories plus the two
// bundle types (desktop_pc, promo_set) — so OrderLineItem/CatalogItem lookups
// have one category space to switch on.
enum CatalogCategory {
  cpu
  gpu
  motherboard
  ram
  storage
  case
  psu
  cooling
  desktop_pc
  promo_set
}

// The 8 individual-part categories only — used for "which slot" on
// DesktopPc/PromoSet/CustomBuild components and for the SpecField catalog.
// A bundle can never fill a slot, so this stays narrower than CatalogCategory.
enum PartCategory {
  cpu
  gpu
  motherboard
  ram
  storage
  case
  psu
  cooling
}

// Only states an admin actually decides live here — in_stock/low_stock/out_of_stock
// are derived from `stock` + a threshold at read time, never stored (see StockStatus
// note on Product below), so they can't drift out of sync with the real count.
enum ProductStatus {
  active
  inactive
  preorder
  discontinued
}

// Admin-account active/inactive is a separate concept from product status —
// kept as its own enum so the two can't accidentally be conflated.
enum AdminAccountStatus {
  active
  inactive
}

enum SpecDataType {
  text
  integer
  decimal
  boolean
}

enum DesktopPcCategory {
  desktop
  mini_pc
  all_in_one
  ai_workstation
  ai_enterprise
}

enum BuildStatus {
  pending
  in_progress
  done
  cancelled
}

enum CustomerStatus {
  active
  inactive
  suspended
}

// paid now lives ONLY here — OrderStatus no longer has a value that means the
// same thing, so the two enums can't disagree about whether an order is paid.
enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum OrderStatus {
  pending
  preparing
  shipping
  completed
  cancelled
}

enum BannerType {
  hero
  promo
  popup
}

enum AdminRole {
  super_admin
  inventory_manager
  sales_staff
  content_moderator
}

// ---------- Catalog: shared product data ----------
// Every sellable thing — the 8 part categories AND the two bundle types — is a
// Product row first. sku/name/brand/pricing/stock/status/description/timestamps
// live here ONCE; category tables below keep only what's genuinely category-specific.
// Motherboard and Storage have no genuinely category-specific columns left at
// all once this centralization happens, so those two tables are gone entirely —
// they exist purely as Product rows (category: motherboard | storage) + EAV specs.

model Product {
  id                 String          @id @default(cuid())
  category           CatalogCategory
  sku                String          @unique
  name               String
  brand              String?
  sellingPrice       Decimal         @db.Decimal(10, 2)
  costPrice          Decimal?        @db.Decimal(10, 2)
  // null = no active promo. Never 0-as-"no promo" — that collides with a
  // genuinely free item. `discount` (sellingPrice - promoPrice) is computed
  // at read time, never stored, so it can't drift from the two source prices.
  promoPrice         Decimal?        @db.Decimal(10, 2)
  stock              Int             @default(0)
  status             ProductStatus   @default(active)
  publishImmediately Boolean         @default(true)
  description        String          @default("")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  specValues ProductSpecValue[]
  extraSpecs ExtraSpec[]
  videoLinks ProductVideoLink[]
  images     ProductImage[]

  cpu     Cpu?
  gpu     Gpu?
  ram     Ram?
  case    Case?
  psu     Psu?
  cooling Cooling?

  desktopPc DesktopPc?
  promoSet  PromoSet?

  desktopPcSlots   DesktopPcComponent[]
  promoSetSlots    PromoSetComponent[]
  customBuildSlots CustomBuildComponent[]
  orderLineItems   OrderLineItem[]

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// ---------- EAV spec system ----------
// Scoped to the 8 individual-part categories only (PartCategory) — a bundle
// (desktop_pc/promo_set) doesn't have its own specs, it's built from parts
// that do. Prisma can't enforce SpecField.category == Product.category across
// these two independent FKs (no cross-table check constraint) — the
// repository layer must verify the category match itself (in a transaction)
// before writing a ProductSpecValue; add a matching Zod-level guard there too.

model SpecField {
  id        String       @id @default(cuid())
  category  PartCategory
  key       String
  label     String
  dataType  SpecDataType @default(text)
  unit      String?
  sortOrder Int          @default(0)

  values ProductSpecValue[]

  @@unique([category, key])
}

model ProductSpecValue {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  field     SpecField @relation(fields: [fieldId], references: [id])
  fieldId   String
  value     String

  @@unique([productId, fieldId])
  @@index([productId])
  @@index([fieldId])
}

// Ad-hoc extra spec rows an admin free-types (not from the fixed SpecField catalog)
model ExtraSpec {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  detail    String

  @@index([productId])
}

model ProductVideoLink {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String

  @@index([productId])
}

// "at most one isPrimary=true row per productId" is enforced by a partial
// unique index (see prisma/manual/constraints.sql) — Prisma's schema language
// has no conditional/partial @@unique, so this can't be declared here.
model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  altText   String   @default("")
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ---------- Category-specific tables ----------
// Only what's left after centralizing shared fields onto Product above.

model Cpu {
  productId            String  @id
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  series               String
  processorLine        String
  socket               String
  processorNumber      String
  cores                Int
  threads              Int
  baseFrequencyGhz     Decimal @db.Decimal(4, 2)
  maxTurboFrequencyGhz Decimal @db.Decimal(4, 2)
  l2CacheMb            Int
  l3CacheMb            Int
  graphics             String
  tdpWatts             Int
  maxTdpWatts          Int
  warrantyMonths       Int

  benchmarks CpuBenchmark[]
}

model CpuBenchmark {
  id    String  @id @default(cuid())
  cpu   Cpu     @relation(fields: [cpuId], references: [productId], onDelete: Cascade)
  cpuId String
  name  String
  score Decimal @db.Decimal(10, 2)
  unit  String

  @@unique([cpuId, name])
}

model Gpu {
  productId    String  @id
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  series       String
  model        String
  chipsetModel String
  memorySize   String
}

model Ram {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  series    String
}

model Case {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayCode String  @unique
}

model Psu {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayCode String  @unique
}

model Cooling {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayCode String  @unique
}

// ---------- Bundles ----------
// Prebuilt desktop / promo set — each slot references a real catalog Product
// instead of a free-text name, so a renamed/discontinued part can't silently
// go stale here. Both are themselves Product rows (category: desktop_pc /
// promo_set) so OrderLineItem can reference "anything sellable" through one FK.

model DesktopPc {
  productId   String            @id
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    DesktopPcCategory
  // Admin-written marketing summary, not auto-generated from components — safe to store.
  specSummary String
  os          String
  warranty    String

  components DesktopPcComponent[]
  highlights DesktopPcHighlight[]
}

model DesktopPcComponent {
  id          String       @id @default(cuid())
  desktopPc   DesktopPc    @relation(fields: [desktopPcId], references: [productId], onDelete: Cascade)
  desktopPcId String
  slot        PartCategory
  product     Product      @relation(fields: [productId], references: [id])
  productId   String

  @@unique([desktopPcId, slot])
  @@index([productId])
}

model DesktopPcHighlight {
  id          String    @id @default(cuid())
  desktopPc   DesktopPc @relation(fields: [desktopPcId], references: [productId], onDelete: Cascade)
  desktopPcId String
  text        String
}

// Whether the bundle is still offered lives on Product.status (active/inactive/
// discontinued) like every other sellable item — no separate lifecycle field,
// that would just be a second place for the same fact to drift out of sync.
model PromoSet {
  productId   String  @id
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code        String  @unique
  // Admin-written marketing summary, not auto-generated from components — safe to store.
  specSummary String
  notes       String  @default("")

  parts      PromoSetComponent[]
  extraParts PromoSetExtraPart[]
  highlights PromoSetHighlight[]
  videoLinks PromoSetVideoLink[]
}

model PromoSetComponent {
  id         String       @id @default(cuid())
  promoSet   PromoSet     @relation(fields: [promoSetId], references: [productId], onDelete: Cascade)
  promoSetId String
  slot       PartCategory
  product    Product      @relation(fields: [productId], references: [id])
  productId  String

  @@unique([promoSetId, slot])
  @@index([productId])
}

model PromoSetExtraPart {
  id         String   @id @default(cuid())
  promoSet   PromoSet @relation(fields: [promoSetId], references: [productId], onDelete: Cascade)
  promoSetId String
  name       String
  value      String
}

model PromoSetHighlight {
  id         String   @id @default(cuid())
  promoSet   PromoSet @relation(fields: [promoSetId], references: [productId], onDelete: Cascade)
  promoSetId String
  text       String
}

model PromoSetVideoLink {
  id         String   @id @default(cuid())
  promoSet   PromoSet @relation(fields: [promoSetId], references: [productId], onDelete: Cascade)
  promoSetId String
  url        String
}

// ---------- Customers & orders ----------

model Customer {
  id              String         @id @default(cuid())
  customerCode    String         @unique
  fullName        String
  username        String         @unique
  email           String         @unique
  phone           String
  registeredAt    DateTime       @default(now())
  lastActiveAt    DateTime       @default(now())
  status          CustomerStatus @default(active)
  shippingAddress String         @default("")
  note            String         @default("")

  orders       Order[]
  customBuilds CustomBuild[]
}

// customerName/Phone/shippingAddress stay on Order (not just via the Customer
// relation) so a completed order keeps the details as they were at checkout,
// even if the customer later edits their profile or the order has no account (guest).
model Order {
  id                    String          @id @default(cuid())
  orderCode             String          @unique
  orderedAt             DateTime        @default(now())
  customer              Customer?       @relation(fields: [customerId], references: [id])
  customerId            String?
  customerName          String
  customerPhone         String
  shippingAddress       String
  postalCode            String
  province              String
  district              String
  subdistrict           String
  paymentMethod         String
  paymentStatus         PaymentStatus   @default(pending)
  status                OrderStatus     @default(pending)
  trackingNumber        String          @default("")
  shippingNote          String          @default("")
  paymentSlipFilename   String          @default("")
  paymentSlipUploadedAt DateTime?
  items                 OrderLineItem[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderedAt])
}

// name/category/quantity/unitPrice are a permanent snapshot of what was
// actually bought — never touched again after checkout, even if the source
// product's name/price changes or the product itself is later deleted
// (productId is nullable and ON DELETE SET NULL for exactly that reason).
model OrderLineItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  name      String
  category  String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

// ---------- Custom PC builds (new-build specs & old-PC upgrade checks) ----------

model CustomBuild {
  id                   String      @id @default(cuid())
  orderNo              String      @unique
  customer             Customer?   @relation(fields: [customerId], references: [id])
  customerId           String?
  // Keeps the name even if there's no linked account (guest) or the
  // customer's profile name later changes — same snapshot rationale as Order.
  customerNameSnapshot String
  status               BuildStatus @default(pending)
  notes                String      @default("")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  components CustomBuildComponent[]

  @@index([customerId])
}

model CustomBuildComponent {
  id            String       @id @default(cuid())
  customBuild   CustomBuild  @relation(fields: [customBuildId], references: [id], onDelete: Cascade)
  customBuildId String
  slot          PartCategory
  product       Product      @relation(fields: [productId], references: [id])
  productId     String
  // snapshot at build time — the catalog price can change later, this shouldn't
  price         Decimal      @db.Decimal(10, 2)

  @@unique([customBuildId, slot])
  @@index([productId])
}

// ---------- Marketing ----------

// "expired" is derived at read time from endDate, not stored, so it can
// never drift out of sync with the date fields — only the admin's on/off
// toggle is persisted.
model Banner {
  id          String     @id @default(cuid())
  name        String
  type        BannerType
  targetLink  String
  startDate   DateTime
  endDate     DateTime
  active      Boolean    @default(true)
  previewTone String     @default("")
  imageUrl    String     @default("")
  imageWidth  Int?
  imageHeight Int?
  imageFormat String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ---------- Admin accounts (RBAC) ----------

model AdminAccount {
  id           String             @id @default(cuid())
  firstName    String
  lastName     String
  email        String             @unique
  phone        String
  passwordHash String
  jobTitle     String             @default("")
  role         AdminRole
  status       AdminAccountStatus @default(active)
  lastActiveAt DateTime?
  createdAt    DateTime           @default(now())
  // "Force logout": any JWT issued before this timestamp is rejected by
  // authMiddleware even though it's still cryptographically valid and
  // unexpired — the only way to invalidate a specific admin's existing
  // sessions with stateless JWTs (no server-side session store to delete from).
  sessionsInvalidatedAt DateTime?

  createdById   String?
  createdBy     AdminAccount?  @relation("AdminCreatedBy", fields: [createdById], references: [id])
  createdAdmins AdminAccount[] @relation("AdminCreatedBy")

  notes String @default("")

  roleHistory  AdminRoleHistory[]
  loginHistory AdminLoginHistory[]
}

model AdminRoleHistory {
  id          String       @id @default(cuid())
  admin       AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId     String
  date        DateTime
  description String
}

model AdminLoginHistory {
  id      String       @id @default(cuid())
  admin   AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId String
  date    DateTime
  device  String
}
