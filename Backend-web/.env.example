# Backend HTTP server
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Required application secrets and database connection
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
JWT_SECRET=

# URL of the teammate's AI compatibility service (separate repo/process, not
# part of this one). Use a loopback URL when running it locally alongside this server.
AI_SERVICE_URL=http://127.0.0.1:8000
# Required only if the AI service is hosted remotely with its own auth token.
AI_SERVICE_TOKEN=

# Backend-to-AI catalog access: same token must be set in the AI service's own
# config — it's the shared secret the two sides use to authenticate each other.
AI_CATALOG_TOKEN=
AI_PORT=8100
