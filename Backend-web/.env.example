# Backend HTTP server
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Required application secrets and database connection
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
JWT_SECRET=

# ai/my-scripts/compatibility_api.py. Use a loopback URL in local development.
AI_SERVICE_URL=http://127.0.0.1:8000
# Required only if the AI service is hosted remotely with BUILDCORES_API_TOKEN.
AI_SERVICE_TOKEN=

# Backend-to-AI catalog access: same token in the AI process (32+ characters).
# run_connected_system.bat generates both service tokens automatically per run.
AI_CATALOG_TOKEN=
AI_PORT=8100
