# Copy to .env.local (git-ignored) and adjust.

# Backend base URL. Either an absolute URL (backend must allow CORS with credentials)...
VITE_API_BASE_URL=http://localhost:4000/api
# ...or "/api" together with VITE_API_PROXY_TARGET to go through the Vite dev proxy:
# VITE_API_BASE_URL=/api
# VITE_API_PROXY_TARGET=http://localhost:4000

# mock = never call the backend (UI work only)
# auto = call the backend, fall back to mock data if it can't be reached (default in `npm run dev`)
# live = backend only, errors are shown to the user (default in `npm run build`)
VITE_API_MODE=auto
